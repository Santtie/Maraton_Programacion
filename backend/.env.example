# Copiar este archivo a .env (nunca subir .env real al repositorio)

# Django
DEBUG=True
SECRET_KEY=change-me-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Proveedor de LLM para el chat RAG: "ollama" (local, recomendado), "gemini" o "groq"
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=gemini

# Ollama (local, sin llave de API) - ver /ML para entrenar y registrar el modelo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=proyectaduria-qwen

# Llaves de respaldo si Ollama no está disponible (dejar vacío si no se usan)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# RAG
RAG_CORPUS_DIR=../corpus
RAG_CHROMA_DIR=./chroma_db
RAG_EMBEDDING_PROVIDER=local
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5
# Umbral bajo a propósito: solo filtra ruido evidente, no decide el dominio (esa
# clasificación la hace el LLM). Ver apps/rag/services/domain_guard.py.
RAG_DOMAIN_SCORE_THRESHOLD=0.30
